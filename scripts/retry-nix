#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: $0 COMMAND [ARG...]" >&2
  exit 1
fi

attempts="${RUFIN_NIX_RETRY_ATTEMPTS:-3}"
delay_seconds="${RUFIN_NIX_RETRY_DELAY_SECONDS:-20}"

if [[ ! "$attempts" =~ ^[1-9][0-9]*$ ]]; then
  echo "bad RUFIN_NIX_RETRY_ATTEMPTS" >&2
  exit 1
fi

if [[ ! "$delay_seconds" =~ ^[0-9]+$ ]]; then
  echo "bad RUFIN_NIX_RETRY_DELAY_SECONDS" >&2
  exit 1
fi

log_file="$(mktemp)"
trap 'rm -f "$log_file"' EXIT
transient_pattern='substitutes?.*(failed|unavailable)|HTTP error (408|409|416|425|429|5[0-9][0-9])|download(ing)? .* (failed|timed out)|unable to download|could not download|failed to download|connection (reset|refused|timed out)|network is unreachable|temporary failure|unexpected EOF|transfer closed|curl:|curl error|curl.*(failed|timed out|transfer)|(TLS|SSL).*(failed|error|connect)'

attempt=1
while (( attempt <= attempts )); do
  : > "$log_file"
  set +e
  "$@" 2>&1 | tee "$log_file"
  status="${PIPESTATUS[0]}"
  set -e

  if [[ "$status" -eq 0 ]] ||
    (( attempt == attempts )) ||
    ! grep -Eiq "$transient_pattern" "$log_file"; then
    exit "$status"
  fi

  sleep_for=$((delay_seconds * attempt))
  echo "transient nix failure; retrying in ${sleep_for}s" >&2
  sleep "$sleep_for"
  attempt=$((attempt + 1))
done

exit "$status"
