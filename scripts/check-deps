#!/usr/bin/env bash
set -euo pipefail

cargo_native_crates=(adw glib gstreamer gstreamer-audio gstreamer-pbutils gtk)
nix_packages=(glib gtk4 libadwaita)
nix_gstreamer_packages=(
  gstreamer
  gst-plugins-base
  gst-plugins-good
  gst-plugins-bad
  gst-plugins-ugly
  gst-libav
)
arch_dependencies=(
  libgcc_s.so
  glib2
  glibc
  gst-libav
  gst-plugins-bad
  gst-plugins-base
  gst-plugins-base-libs
  gst-plugins-good
  gst-plugins-ugly
  gstreamer
  gtk4
  hicolor-icon-theme
  libadwaita
)
arch_build_dependencies=(cargo gettext pkgconf)
arch_git_build_dependencies=(cargo gettext git pkgconf)

usage() {
  cat >&2 <<'USAGE'
Usage: scripts/check-deps [--check]
       scripts/check-deps --nix-package PATH
       scripts/check-deps --arch-build-packages
USAGE
}

root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
package_start_marker='# Generated Linux package dependencies start.'
package_end_marker='# Generated Linux package dependencies end.'
development_start_marker='# Generated Linux development dependencies start.'
development_end_marker='# Generated Linux development dependencies end.'
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

compare_lists() {
  local label="$1" expected_file="$2" actual_file="$3"
  sort -u "$expected_file" -o "$expected_file"
  sort -u "$actual_file" -o "$actual_file"
  if ! diff -u "$expected_file" "$actual_file"; then
    echo "$label differ from scripts/check-deps" >&2
    exit 1
  fi
}

verify_cargo_crates() {
  printf '%s\n' "${cargo_native_crates[@]}" > "$tmpdir/expected-cargo"
  sed -nE \
    's/^[[:space:]]*(adw|gdk-pixbuf|glib|gstreamer|gstreamer-audio|gstreamer-pbutils|gtk)(\.workspace)?[[:space:]]*=.*/\1/p' \
    "$root"/crates/*/Cargo.toml > "$tmpdir/actual-cargo"
  compare_lists "Cargo native crates" "$tmpdir/expected-cargo" "$tmpdir/actual-cargo"
}

render_flake_package() {
  printf '%s\n' \
    '            buildInputs =' \
    '              with pkgs;' \
    '              ['
  printf '                %s\n' "${nix_packages[@]}"
  printf '%s\n' '              ]' '              ++ (with gst_all_1; ['
  printf '                %s\n' "${nix_gstreamer_packages[@]}"
  printf '%s\n' '              ]);'
}

render_flake_development() {
  printf '%s\n' '              ++ (with pkgs; ['
  printf '                %s\n' "${nix_packages[@]}"
  printf '%s\n' '              ])' '              ++ (with pkgs.gst_all_1; ['
  printf '                %s\n' "${nix_gstreamer_packages[@]}"
  printf '%s\n' '              ]);'
}

render_pkgbuild() {
  printf '%s\n' 'depends=('
  printf "  '%s'\n" "${arch_dependencies[@]}"
  printf '%s\n' ')'
  if [[ "$1" == bin ]]; then
    return
  fi

  local -a build_dependencies=("${arch_build_dependencies[@]}")
  if [[ "$1" == git ]]; then
    build_dependencies=("${arch_git_build_dependencies[@]}")
  fi
  printf '%s\n' 'makedepends=('
  printf "  '%s'\n" "${build_dependencies[@]}"
  printf '%s\n' ')'
}

render_arch_build_packages() {
  local dependency
  for dependency in "${arch_dependencies[@]}"; do
    case "$dependency" in
      libgcc_s.so) printf '%s\n' gcc-libs ;;
      *) printf '%s\n' "$dependency" ;;
    esac
  done
  printf '%s\n' "${arch_build_dependencies[@]}"
}

project_file() {
  local path="$1" body="$2" mode="$3" start_marker="$4" end_marker="$5"
  local generated="$tmpdir/generated"
  if ! awk -v start="$start_marker" -v end="$end_marker" -v body="$body" '
    index($0, start) {
      if (++starts != 1) exit 2
      print
      while ((getline line < body) > 0) print line
      close(body)
      skipping = 1
      next
    }
    index($0, end) {
      if (!skipping || ++ends != 1) exit 2
      skipping = 0
      print
      next
    }
    !skipping { print }
    END { if (starts != 1 || ends != 1 || skipping) exit 2 }
  ' "$path" > "$generated"; then
    echo "$path has an invalid generated dependency block" >&2
    exit 1
  fi

  if cmp -s "$path" "$generated"; then
    return
  fi
  if [[ "$mode" == check ]]; then
    echo "$path is stale; run just deps" >&2
    exit 1
  fi
  cp "$generated" "$path"
}

verify_nix_package() {
  local path="$1"
  printf '%s\n' "${nix_packages[@]}" > "$tmpdir/expected-nix"
  printf '%s\n' "${nix_gstreamer_packages[@]}" > "$tmpdir/expected-nix-gstreamer"
  : > "${tmpdir}/actual-nix"
  : > "${tmpdir}/actual-nix-gstreamer"
  awk -v packages="$tmpdir/actual-nix" -v gstreamer="$tmpdir/actual-nix-gstreamer" '
    /^[[:space:]]*buildInputs = \[/ { inputs = 1; next }
    inputs && /with gst_all_1/ { gst = 1; next }
    inputs {
      line = $0
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (line ~ /^[A-Za-z0-9_-]+$/) print line >> (gst ? gstreamer : packages)
      if (gst && line == "]);" ) exit
    }
  ' "$path"
  compare_lists "Nix package inputs" "$tmpdir/expected-nix" "$tmpdir/actual-nix"
  compare_lists \
    "Nix GStreamer inputs" \
    "$tmpdir/expected-nix-gstreamer" \
    "$tmpdir/actual-nix-gstreamer"
}

case "${1:-}" in
  --nix-package)
    [[ $# -eq 2 ]] || { usage; exit 1; }
    verify_nix_package "$2"
    exit
    ;;
  --arch-build-packages)
    [[ $# -eq 1 ]] || { usage; exit 1; }
    render_arch_build_packages | sort -u
    exit
    ;;
  --check)
    [[ $# -eq 1 ]] || { usage; exit 1; }
    mode=check
    ;;
  "")
    mode='write'
    ;;
  -h|--help)
    usage
    exit
    ;;
  *)
    usage
    exit 1
    ;;
esac

verify_cargo_crates
render_flake_package > "$tmpdir/flake-package"
render_flake_development > "$tmpdir/flake-development"
render_pkgbuild bin > "$tmpdir/aur-bin"
render_pkgbuild git > "$tmpdir/aur-git"
project_file \
  "$root/flake.nix" "$tmpdir/flake-package" "$mode" \
  "$package_start_marker" "$package_end_marker"
project_file \
  "$root/flake.nix" "$tmpdir/flake-development" "$mode" \
  "$development_start_marker" "$development_end_marker"
project_file \
  "$root/packaging/aur/rufin-bin/PKGBUILD.template" "$tmpdir/aur-bin" "$mode" \
  "$package_start_marker" "$package_end_marker"
project_file \
  "$root/packaging/aur/rufin-git/PKGBUILD" "$tmpdir/aur-git" "$mode" \
  "$package_start_marker" "$package_end_marker"
