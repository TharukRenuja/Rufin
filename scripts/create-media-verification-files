#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: scripts/create-media-verification-files OUTPUT_DIRECTORY" >&2
  exit 1
fi
for command_name in gst-launch-1.0 wavpack; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Required media fixture command is unavailable: ${command_name}" >&2
    exit 1
  fi
done

output_directory="$1"
mkdir -p "$output_directory"

gst-launch-1.0 -q \
  audiotestsrc num-buffers=20 ! audioconvert ! lamemp3enc ! \
  filesink location="$output_directory/package-check.mp3"
gst-launch-1.0 -q \
  audiotestsrc num-buffers=20 ! audioconvert ! flacenc ! \
  filesink location="$output_directory/package-check.flac"
gst-launch-1.0 -q \
  audiotestsrc num-buffers=20 ! audioconvert ! avenc_aac ! mp4mux ! \
  filesink location="$output_directory/package-check.m4a"
gst-launch-1.0 -q \
  audiotestsrc num-buffers=20 ! audioconvert ! vorbisenc ! oggmux ! \
  filesink location="$output_directory/package-check.ogg"
gst-launch-1.0 -q \
  audiotestsrc num-buffers=20 ! audioconvert ! opusenc ! oggmux ! \
  filesink location="$output_directory/package-check.opus"
gst-launch-1.0 -q \
  audiotestsrc num-buffers=20 ! audioconvert ! audio/x-raw,format=S16LE ! wavenc ! \
  filesink location="$output_directory/package-check.wav"
wavpack -q -y \
  "$output_directory/package-check.wav" \
  -o "$output_directory/package-check.wv"
gst-launch-1.0 -q \
  audiotestsrc num-buffers=20 ! audioconvert ! vorbisenc ! matroskamux ! \
  filesink location="$output_directory/package-check.mka"
gst-launch-1.0 -q \
  audiotestsrc num-buffers=20 ! audioconvert ! avenc_wmav2 ! asfmux ! \
  filesink location="$output_directory/package-check.wma"

for media in "$output_directory"/*; do
  test -s "$media"
done
