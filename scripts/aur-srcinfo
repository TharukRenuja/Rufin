#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: scripts/aur-srcinfo [--check]" >&2
}

case "${1:-}" in
  --check)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    mode='check'
    ;;
  "")
    mode='write'
    ;;
  -h|--help)
    usage
    exit
    ;;
  *)
    usage
    exit 2
    ;;
esac

root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
package_dir="$root/packaging/aur/rufin-git"
srcinfo="$package_dir/.SRCINFO"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

makepkg_args=(--printsrcinfo)
if [[ ! -r /etc/makepkg.conf ]]; then
  makepkg_config="$tmpdir/makepkg.conf"
  printf '%s\n' \
    'CARCH="x86_64"' \
    'CHOST="x86_64-pc-linux-gnu"' \
    "PKGEXT='.pkg.tar.zst'" \
    "SRCEXT='.src.tar.gz'" > "$makepkg_config"
  makepkg_args=(--config "$makepkg_config" "${makepkg_args[@]}")
fi

(
  cd "$package_dir"
  makepkg "${makepkg_args[@]}"
) > "$tmpdir/SRCINFO"

if cmp -s "$srcinfo" "$tmpdir/SRCINFO"; then
  exit
fi
if [[ "$mode" == check ]]; then
  diff -u "$srcinfo" "$tmpdir/SRCINFO" || true
  echo "$srcinfo is stale; run just deps" >&2
  exit 1
fi
cp "$tmpdir/SRCINFO" "$srcinfo"
