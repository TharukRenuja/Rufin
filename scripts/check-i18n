#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: $0 [--base-ref REF] [--head-ref REF]" >&2
}

base_ref="${RUFIN_I18N_SCOPE_BASE_REF:-origin/main}"
head_ref="${RUFIN_I18N_SCOPE_HEAD_REF:-HEAD}"
allow_catalog_only="${RUFIN_I18N_ALLOW_CATALOG_ONLY:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base-ref)
      base_ref="${2:-}"
      if [[ -z "$base_ref" ]]; then
        echo "--base-ref requires a ref" >&2
        exit 1
      fi
      shift 2
      ;;
    --head-ref)
      head_ref="${2:-}"
      if [[ -z "$head_ref" ]]; then
        echo "--head-ref requires a ref" >&2
        exit 1
      fi
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unexpected argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

git rev-parse --verify --quiet "${base_ref}^{commit}" >/dev/null ||
  { echo "unknown base ref: $base_ref" >&2; exit 1; }
git rev-parse --verify --quiet "${head_ref}^{commit}" >/dev/null ||
  { echo "unknown head ref: $head_ref" >&2; exit 1; }

base_commit="$(git merge-base "$head_ref" "$base_ref" 2>/dev/null || true)"
if [[ -z "$base_commit" ]]; then
  base_commit="$base_ref"
fi

collect_changed_paths() {
  git diff --name-only "$base_commit" "$head_ref"
  if [[ "$head_ref" == "HEAD" ]]; then
    git diff --name-only
    git diff --cached --name-only
    git ls-files --others --exclude-standard
  fi
}

mapfile -t changed_paths < <(collect_changed_paths | sed '/^$/d' | sort -u)

is_po_catalog() {
  local path="$1"
  local file="${path#locales/}"
  [[ "$path" == locales/* && "$file" != */* && "$file" == *.po ]]
}

is_i18n_tooling_path() {
  local path="$1"
  case "$path" in
    .github/workflows/checks.yml|\
    .github/workflows/dependency-artifacts.yml|\
    .github/workflows/nix-cache.yml|\
    .github/workflows/nix.yml|\
    crates/xtask/src/process.rs|\
    crates/xtask/src/verify.rs|\
    locales/POTFILES.in|\
    locales/rufin.pot|\
    scripts/check-i18n|\
    scripts/retry-nix)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

catalog_changed=0
for path in "${changed_paths[@]}"; do
  if is_po_catalog "$path"; then
    catalog_changed=1
    break
  fi
done

if [[ "$catalog_changed" != "1" ]]; then
  exit 0
fi

non_catalog_paths=()
mixed_paths=()
for path in "${changed_paths[@]}"; do
  if is_po_catalog "$path"; then
    continue
  fi

  non_catalog_paths+=("$path")
  if ! is_i18n_tooling_path "$path"; then
    mixed_paths+=("$path")
  fi
done

if [[ "${#non_catalog_paths[@]}" -eq 0 ]]; then
  if [[ "$allow_catalog_only" == "1" ]]; then
    exit 0
  fi

  echo "locales/*.po changes are Weblate-owned." >&2
  exit 1
fi

if [[ "${#mixed_paths[@]}" -eq 0 ]]; then
  exit 0
fi

echo "locales/*.po cannot be mixed with source changes." >&2
printf 'mixed path: %s\n' "${mixed_paths[@]}" >&2
exit 1
