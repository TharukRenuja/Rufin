#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
artifact_root="${RUFIN_ARTIFACT_ROOT:-${repo_root}/.local/artifacts}"
work_root="${RUFIN_DMG_WORK_ROOT:-${artifact_root}/macos}"
target_dir="${RUFIN_DMG_TARGET_DIR:-${work_root}/target}"
app_path="${work_root}/Rufin.app"
dmg_root="${work_root}/dmg"
dmg_path="${RUFIN_DMG_ARTIFACT:-${artifact_root}/Rufin.dmg}"

case "$work_root" in
    "$repo_root"/*/macos)
        ;;
    *)
        echo "Refusing unsafe macOS packaging directory: ${work_root:-empty}" >&2
        exit 1
        ;;
esac

if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "just build dmg must run on macOS." >&2
    exit 1
fi

required_commands=(
    brew cargo codesign ditto dylibbundler file gio-querymodules
    glib-compile-schemas hdiutil iconutil install_name_tool lipo msgfmt otool pkg-config
    rsvg-convert
)
for command_name in "${required_commands[@]}"; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "Required macOS packaging command is unavailable: ${command_name}" >&2
        exit 1
    fi
done

mach_o_dependencies() {
    otool -L "$1" \
        | sed -n 's/^[[:space:]][[:space:]]*\([^[:space:]]*\).*/\1/p'
}

mach_o_install_name() {
    otool -D "$1" 2>/dev/null \
        | sed -n '2s/^[[:space:]]*//p'
}

mach_o_rpaths() {
    otool -l "$1" \
        | awk '
            $1 == "cmd" && $2 == "LC_RPATH" {
                reading_rpath = 1
                next
            }
            reading_rpath && $1 == "path" {
                print $2
                reading_rpath = 0
            }
        '
}

prepare_mach_o_for_bundle() {
    local bundled_file="$1"
    local architectures
    local bundled_mode
    local duplicate_rpaths
    local thin_file
    local rpath

    architectures="$(lipo -archs "$bundled_file")"
    case " $architectures " in
        *" $package_arch "*)
            ;;
        *)
            echo "The bundled Mach-O does not support ${package_arch}: ${bundled_file}" >&2
            exit 1
            ;;
    esac

    if [[ "$architectures" != "$package_arch" ]]; then
        thin_file="${bundled_file}.rufin-thin"
        bundled_mode="$(stat -f '%Lp' "$bundled_file")"
        lipo "$bundled_file" -thin "$package_arch" -output "$thin_file"
        chmod "$bundled_mode" "$thin_file"
        mv "$thin_file" "$bundled_file"
    fi

    while IFS= read -r rpath; do
        while mach_o_rpaths "$bundled_file" | grep -Fx "$rpath" >/dev/null; do
            install_name_tool -delete_rpath "$rpath" "$bundled_file"
        done
        install_name_tool -add_rpath "$rpath" "$bundled_file"
    done < <(mach_o_rpaths "$bundled_file" | LC_ALL=C sort -u)

    if [[ "$(lipo -archs "$bundled_file")" != "$package_arch" ]]; then
        echo "The bundled Mach-O architecture was not normalized: ${bundled_file}" >&2
        exit 1
    fi
    duplicate_rpaths="$(mach_o_rpaths "$bundled_file" | LC_ALL=C sort | uniq -d)"
    if [[ -n "$duplicate_rpaths" ]]; then
        echo "$duplicate_rpaths" >&2
        echo "Duplicate rpath remains in ${bundled_file}." >&2
        exit 1
    fi
}

brew_prefix="$(brew --prefix)"
gstreamer_plugins="$(pkg-config --variable=pluginsdir gstreamer-1.0)"
pixbuf_loaders="$(pkg-config --variable=gdk_pixbuf_moduledir gdk-pixbuf-2.0)"
plugin_scanner_dir="$(pkg-config --variable=pluginscannerdir gstreamer-1.0)"
plugin_scanner="${plugin_scanner_dir}/gst-plugin-scanner"
gstreamer_framework="${RUFIN_MACOS_GSTREAMER_FRAMEWORK:-/Library/Frameworks/GStreamer.framework/Versions/1.0}"
wavpack_plugin="${gstreamer_framework}/lib/gstreamer-1.0/libgstwavpack.dylib"

if [[ -z "$gstreamer_plugins" || ! -d "$gstreamer_plugins" ]]; then
    echo "The Homebrew GStreamer plugin directory is unavailable: ${gstreamer_plugins:-not set}" >&2
    exit 1
fi
if [[ -z "$pixbuf_loaders" || ! -d "$pixbuf_loaders" ]]; then
    echo "The Homebrew pixbuf loader directory is unavailable: ${pixbuf_loaders:-not set}" >&2
    exit 1
fi
if [[ -z "$plugin_scanner_dir" || ! -f "$plugin_scanner" ]]; then
    echo "The Homebrew GStreamer plugin scanner is unavailable: ${plugin_scanner}" >&2
    exit 1
fi
if [[ ! -f "$wavpack_plugin" ]]; then
    echo "The GStreamer runtime WavPack decoder is unavailable: ${gstreamer_framework}" >&2
    echo "Install the Homebrew gstreamer-runtime cask before building the disk image." >&2
    exit 1
fi
homebrew_gstreamer_version="$(pkg-config --modversion gstreamer-1.0)"
framework_gstreamer_version="$(
    "$gstreamer_framework/bin/gst-launch-1.0" --version \
        | sed -n 's/^GStreamer //p' \
        | head -n 1
)"
if [[ -z "$framework_gstreamer_version" \
    || "$framework_gstreamer_version" != "$homebrew_gstreamer_version" ]]; then
    echo "The Homebrew and GStreamer runtime versions do not match." >&2
    echo "Homebrew: ${homebrew_gstreamer_version}; runtime: ${framework_gstreamer_version:-unknown}" >&2
    exit 1
fi
wavpack_library_name="$(
    mach_o_dependencies "$wavpack_plugin" \
        | sed -n '/libwavpack[^[:space:]]*\.dylib$/p' \
        | head -n 1
)"
wavpack_library="${gstreamer_framework}/lib/$(basename "$wavpack_library_name")"
if [[ -z "$wavpack_library_name" || ! -f "$wavpack_library" ]]; then
    echo "The GStreamer runtime WavPack library is unavailable: ${wavpack_library}" >&2
    exit 1
fi

version="$(sed -n 's/^version = "\([^"]*\)"/\1/p' "${repo_root}/Cargo.toml" | head -n 1)"
deployment_target="${MACOSX_DEPLOYMENT_TARGET:-15.0}"
package_arch="$(uname -m)"
if [[ -z "$version" ]]; then
    echo "Could not read the Rufin version from Cargo.toml." >&2
    exit 1
fi
if [[ "$package_arch" != "arm64" && "$package_arch" != "x86_64" ]]; then
    echo "Unsupported macOS package architecture: ${package_arch}" >&2
    exit 1
fi

rm -rf "$app_path" "$dmg_root"
mkdir -p \
    "$app_path/Contents/Frameworks" \
    "$app_path/Contents/MacOS" \
    "$app_path/Contents/Resources/lib/gdk-pixbuf-2.0/loaders" \
    "$app_path/Contents/Resources/lib/gio/modules" \
    "$app_path/Contents/Resources/lib/gstreamer-1.0" \
    "$app_path/Contents/Resources/share"

MACOSX_DEPLOYMENT_TARGET="$deployment_target" \
    CARGO_TARGET_DIR="$target_dir" cargo build --locked --release -p rufin
cp "$target_dir/release/rufin" "$app_path/Contents/MacOS/rufin-bin"
cp "${repo_root}/packaging/macos/rufin" "$app_path/Contents/MacOS/rufin"
cp "$plugin_scanner" "$app_path/Contents/MacOS/gst-plugin-scanner"
cp "$(brew --prefix gdk-pixbuf)/bin/gdk-pixbuf-query-loaders" \
    "$app_path/Contents/MacOS/gdk-pixbuf-query-loaders"
chmod +x "$app_path/Contents/MacOS/"*
sed \
    -e "s/@VERSION@/${version}/g" \
    -e "s/@MINIMUM_SYSTEM_VERSION@/${deployment_target}/g" \
    "${repo_root}/packaging/macos/Info.plist.in" \
    >"$app_path/Contents/Info.plist"

copy_directory() {
    local source_path="$1"
    local destination_path="$2"
    if [[ -d "$source_path" ]]; then
        mkdir -p "$destination_path"
        cp -R -L "$source_path"/. "$destination_path"/
    fi
}

gstreamer_plugin_names=(
    libgstaiff.dylib
    libgstalaw.dylib
    libgstapetag.dylib
    libgstasf.dylib
    libgstaudioconvert.dylib
    libgstaudioparsers.dylib
    libgstaudioresample.dylib
    libgstautodetect.dylib
    libgstcoreelements.dylib
    libgstequalizer.dylib
    libgstfdkaac.dylib
    libgstflac.dylib
    libgstid3demux.dylib
    libgstisomp4.dylib
    libgstlevel.dylib
    libgstlibav.dylib
    libgstmatroska.dylib
    libgstmpg123.dylib
    libgstmusepack.dylib
    libgstmulaw.dylib
    libgstogg.dylib
    libgstopus.dylib
    libgstopusparse.dylib
    libgstosxaudio.dylib
    libgstpbtypes.dylib
    libgstplayback.dylib
    libgstreplaygain.dylib
    libgstsoup.dylib
    libgstspeex.dylib
    libgsttypefindfunctions.dylib
    libgstvolume.dylib
    libgstvorbis.dylib
    libgstwavparse.dylib
)
for plugin_name in "${gstreamer_plugin_names[@]}"; do
    plugin_path="$gstreamer_plugins/$plugin_name"
    if [[ ! -f "$plugin_path" ]]; then
        echo "Required GStreamer plugin is unavailable: ${plugin_path}" >&2
        exit 1
    fi
    cp -L "$plugin_path" \
        "$app_path/Contents/Resources/lib/gstreamer-1.0/$plugin_name"
done
cp -L "$wavpack_plugin" \
    "$app_path/Contents/Resources/lib/gstreamer-1.0/libgstwavpack.dylib"
copy_directory "$pixbuf_loaders" \
    "$app_path/Contents/Resources/lib/gdk-pixbuf-2.0/loaders"
copy_directory "${brew_prefix}/lib/gio/modules" \
    "$app_path/Contents/Resources/lib/gio/modules"
copy_directory "${brew_prefix}/share/glib-2.0/schemas" \
    "$app_path/Contents/Resources/share/glib-2.0/schemas"
copy_directory "${brew_prefix}/share/gstreamer-1.0" \
    "$app_path/Contents/Resources/share/gstreamer-1.0"
copy_directory "${brew_prefix}/share/gtk-4.0" \
    "$app_path/Contents/Resources/share/gtk-4.0"
copy_directory "${brew_prefix}/share/icons/Adwaita" \
    "$app_path/Contents/Resources/share/icons/Adwaita"
copy_directory "${brew_prefix}/share/icons/AdwaitaLegacy" \
    "$app_path/Contents/Resources/share/icons/AdwaitaLegacy"
copy_directory "${brew_prefix}/share/icons/hicolor" \
    "$app_path/Contents/Resources/share/icons/hicolor"
copy_directory "${repo_root}/data/icons/hicolor" \
    "$app_path/Contents/Resources/share/icons/hicolor"
copy_directory "${brew_prefix}/share/mime" \
    "$app_path/Contents/Resources/share/mime"

mkdir -p \
    "$app_path/Contents/Resources/share/rufin" \
    "$app_path/Contents/Resources/share/licenses/rufin"
cp "${repo_root}/data/japanese-readings.dic" \
    "$app_path/Contents/Resources/share/rufin/japanese-readings.dic"
cp "${repo_root}/data/japanese-readings.LICENSE" \
    "$app_path/Contents/Resources/share/licenses/rufin/japanese-readings.LICENSE"
cp "${repo_root}/LICENSE" "$app_path/Contents/Resources/LICENSE"

for po_file in "${repo_root}"/crates/localization/locales/*.po; do
    language="$(basename "$po_file" .po)"
    copy_directory \
        "${brew_prefix}/share/locale/${language}" \
        "$app_path/Contents/Resources/share/locale/${language}"
    locale_dir="$app_path/Contents/Resources/share/locale/${language}/LC_MESSAGES"
    mkdir -p "$locale_dir"
    msgfmt --check "$po_file" -o "$locale_dir/rufin.mo"
done

glib-compile-schemas "$app_path/Contents/Resources/share/glib-2.0/schemas"
gio-querymodules "$app_path/Contents/Resources/lib/gio/modules"

iconset="$work_root/Rufin.iconset"
rm -rf "$iconset"
mkdir -p "$iconset"
icon_source="${repo_root}/data/icons/hicolor/scalable/apps/io.github.screwys.Rufin.svg"
for icon_size in 16 32 128 256 512; do
    rsvg-convert -w "$icon_size" -h "$icon_size" "$icon_source" \
        >"$iconset/icon_${icon_size}x${icon_size}.png"
    doubled_size=$((icon_size * 2))
    rsvg-convert -w "$doubled_size" -h "$doubled_size" "$icon_source" \
        >"$iconset/icon_${icon_size}x${icon_size}@2x.png"
done
iconutil -c icns "$iconset" -o "$app_path/Contents/Resources/Rufin.icns"

files_to_fix=(
    "$app_path/Contents/MacOS/rufin-bin"
    "$app_path/Contents/MacOS/gdk-pixbuf-query-loaders"
    "$app_path/Contents/MacOS/gst-plugin-scanner"
)
while IFS= read -r -d '' module_path; do
    files_to_fix+=("$module_path")
done < <(
    find \
        "$app_path/Contents/Resources/lib/gdk-pixbuf-2.0/loaders" \
        "$app_path/Contents/Resources/lib/gio/modules" \
        "$app_path/Contents/Resources/lib/gstreamer-1.0" \
        -type f \( -name '*.dylib' -o -name '*.so' \) -print0
)

dependency_sources="$work_root/dependency-sources"
rm -rf "$dependency_sources"
mkdir -p "$dependency_sources"
while IFS= read -r -d '' dependency; do
    ln -s "$dependency" "$dependency_sources/$(basename "$dependency")"
done < <(find -L "${brew_prefix}/lib" -maxdepth 1 -type f -name '*.dylib' -print0)
ln -sfn "$wavpack_library" "$dependency_sources/$(basename "$wavpack_library")"

dylib_args=(-od -b -d "$app_path/Contents/Frameworks" -p '@executable_path/../Frameworks/')
for file_to_fix in "${files_to_fix[@]}"; do
    dylib_args+=(-x "$file_to_fix")
done
dylibbundler "${dylib_args[@]}" -s "$dependency_sources" -ns

bundled_rufin_binary="$app_path/Contents/MacOS/rufin-bin"
if ! mach_o_rpaths "$bundled_rufin_binary" | grep -Fx '/usr/lib/swift' >/dev/null; then
    install_name_tool -add_rpath '/usr/lib/swift' "$bundled_rufin_binary"
fi

bundled_wavpack_library="$app_path/Contents/Frameworks/$(basename "$wavpack_library")"
bundled_wavpack_plugin="$app_path/Contents/Resources/lib/gstreamer-1.0/libgstwavpack.dylib"
bundled_wavpack_name="@executable_path/../Frameworks/$(basename "$wavpack_library")"
cp -L "$wavpack_library" "$bundled_wavpack_library"
install_name_tool -id "$bundled_wavpack_name" "$bundled_wavpack_library"
install_name_tool -change \
    "$wavpack_library_name" \
    "$bundled_wavpack_name" \
    "$bundled_wavpack_plugin"
if ! mach_o_dependencies "$bundled_wavpack_plugin" \
    | grep -Fx "$bundled_wavpack_name" >/dev/null; then
    echo "The bundled GStreamer WavPack plugin does not use its bundled library." >&2
    exit 1
fi

while IFS= read -r -d '' bundled_file; do
    if file "$bundled_file" | grep -q 'Mach-O'; then
        prepare_mach_o_for_bundle "$bundled_file"
        codesign --force --sign - "$bundled_file"
        install_name="$(mach_o_install_name "$bundled_file" || true)"
        external_dependencies="$(mach_o_dependencies "$bundled_file" \
            | grep -vFx "$install_name" \
            | grep '^/' \
            | grep -Ev '^(/usr/lib/|/System/Library/)' || true)"
        if [[ -n "$external_dependencies" ]]; then
            echo "$external_dependencies" >&2
            echo "External library path remains in ${bundled_file}." >&2
            exit 1
        fi
    fi
done < <(find "$app_path/Contents" -type f -print0)
if ! mach_o_rpaths "$bundled_rufin_binary" | grep -Fx '/usr/lib/swift' >/dev/null; then
    echo "The bundled Rufin binary is missing the macOS Swift runtime path." >&2
    exit 1
fi
codesign --force --sign - --identifier io.github.screwys.Rufin "$app_path"
codesign --verify --deep --strict "$app_path"

mkdir -p "$dmg_root"
ditto "$app_path" "$dmg_root/Rufin.app"
ln -s /Applications "$dmg_root/Applications"
mkdir -p "$(dirname "$dmg_path")"
hdiutil create -volname Rufin -srcfolder "$dmg_root" -ov -format UDZO "$dmg_path"
hdiutil verify "$dmg_path"

echo "Built ${dmg_path}"
