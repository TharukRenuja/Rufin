FROM registry.fedoraproject.org/fedora-minimal:44

LABEL org.opencontainers.image.source="https://github.com/screwys/Rufin" \
      org.opencontainers.image.description="Rufin development environment"

ARG LIBADWAITA_VERSION=1.8.5.1
ARG LIBADWAITA_SHA256=7a306296deda956207425b375355c212d254f27db6560733d08dca12fb5e52c3

RUN sed -i 's/^countme=1$/countme=0/' /etc/yum.repos.d/*.repo \
    && dnf -y \
        --setopt=install_weak_deps=False \
        --setopt=tsflags=nodocs \
        install \
            bash \
            ca-certificates \
            cargo \
            curl \
            findutils \
            gettext \
            git-core \
            gzip \
            meson \
            mingw-nsis-base \
            mingw32-nsis \
            mingw64-adwaita-icon-theme \
            mingw64-appstream \
            mingw64-fribidi \
            mingw64-gcc \
            mingw64-gcc-c++ \
            mingw64-gstreamer1 \
            mingw64-gstreamer1-plugins-bad-free \
            mingw64-gstreamer1-plugins-base \
            mingw64-gstreamer1-plugins-good \
            mingw64-gtk4 \
            mingw64-hicolor-icon-theme \
            mingw64-nsis \
            ninja-build \
            nix \
            rust \
            rust-std-static-x86_64-pc-windows-gnu \
            sassc \
            shadow-utils \
            tar \
            which \
            xz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN dnf -y \
        --setopt=install_weak_deps=False \
        --setopt=tsflags=nodocs \
        install glib2-devel \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN curl --fail --location --silent --show-error \
        --output "/tmp/libadwaita-${LIBADWAITA_VERSION}.tar.xz" \
        "https://download.gnome.org/sources/libadwaita/1.8/libadwaita-${LIBADWAITA_VERSION}.tar.xz" \
    && printf '%s  %s\n' \
        "${LIBADWAITA_SHA256}" \
        "/tmp/libadwaita-${LIBADWAITA_VERSION}.tar.xz" \
        | sha256sum --check --strict - \
    && tar --extract \
        --file "/tmp/libadwaita-${LIBADWAITA_VERSION}.tar.xz" \
        --directory /tmp \
    && mingw64-meson \
        /tmp/libadwaita-build \
        "/tmp/libadwaita-${LIBADWAITA_VERSION}" \
        --wrap-mode=nodownload \
        -Ddocumentation=false \
        -Dexamples=false \
        -Dintrospection=disabled \
        -Dtests=false \
        -Dvapi=false \
    && meson compile -C /tmp/libadwaita-build \
    && meson install -C /tmp/libadwaita-build \
    && rm -rf \
        /tmp/libadwaita-build \
        "/tmp/libadwaita-${LIBADWAITA_VERSION}" \
        "/tmp/libadwaita-${LIBADWAITA_VERSION}.tar.xz"

RUN groupadd --gid 1000 rufin \
    && useradd --uid 1000 --gid 1000 --create-home rufin \
    && mkdir -p /nix /workspace \
    && chown -R rufin:rufin /nix /workspace

COPY --chmod=0644 nix.conf /etc/nix/nix.conf

ENV DO_NOT_TRACK=1 \
    HOME=/home/rufin \
    NIX_REMOTE=local \
    RUFIN_WINDOWS_CARGO=/usr/bin/cargo \
    RUFIN_WINDOWS_PREFIX=/usr/x86_64-w64-mingw32/sys-root/mingw \
    RUFIN_WINDOWS_RUSTC=/usr/bin/rustc \
    USER=rufin

USER rufin
WORKDIR /workspace

CMD ["bash"]
