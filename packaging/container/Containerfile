FROM registry.fedoraproject.org/fedora-minimal:44

LABEL org.opencontainers.image.source="https://github.com/screwys/Rufin" \
      org.opencontainers.image.description="Rufin development environment"

ARG MSYS2_KEYRING_VERSION=1~20260214-1
ARG MSYS2_KEYRING_SHA256=c93044188c49f6f75e6f75709017ffa9234c2bdd8fe7c6a4c47d62a9cd8bfb1f

RUN sed -i 's/^countme=1$/countme=0/' /etc/yum.repos.d/*.repo \
    && dnf -y \
        --setopt=install_weak_deps=False \
        --setopt=tsflags=nodocs \
        install \
            bash \
            ca-certificates \
            cargo \
            curl \
            findutils \
            gettext \
            git-core \
            glib2 \
            gzip \
            mingw-nsis-base \
            mingw32-nsis \
            mingw64-gcc \
            mingw64-gcc-c++ \
            mingw64-nsis \
            ninja-build \
            nix \
            pacman \
            rust \
            rust-std-static-x86_64-pc-windows-gnu \
            sassc \
            shadow-utils \
            tar \
            which \
            xz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY --chmod=0644 msys2-pacman.conf /etc/pacman-msys2.conf

RUN curl --fail --location --silent --show-error \
        --output /tmp/msys2-keyring.pkg.tar.zst \
        "https://repo.msys2.org/msys/x86_64/msys2-keyring-${MSYS2_KEYRING_VERSION}-any.pkg.tar.zst" \
    && printf '%s  %s\n' \
        "${MSYS2_KEYRING_SHA256}" \
        /tmp/msys2-keyring.pkg.tar.zst \
        | sha256sum --check --strict - \
    && mkdir -p /opt/msys2/var/lib/pacman \
    && bsdtar \
        --extract \
        --file /tmp/msys2-keyring.pkg.tar.zst \
        --directory /opt/msys2 \
    && pacman-key \
        --gpgdir /opt/msys2/etc/pacman.d/gnupg \
        --init \
    && pacman-key \
        --gpgdir /opt/msys2/etc/pacman.d/gnupg \
        --populate-from /opt/msys2/usr/share/pacman/keyrings \
        --populate msys2 \
    && pacman \
        --config /etc/pacman-msys2.conf \
        --dbpath /opt/msys2/var/lib/pacman \
        --gpgdir /opt/msys2/etc/pacman.d/gnupg \
        --noconfirm \
        --root /opt/msys2 \
        -Sy \
            mingw-w64-ucrt-x86_64-adwaita-icon-theme \
            mingw-w64-ucrt-x86_64-gdk-pixbuf2 \
            mingw-w64-ucrt-x86_64-gettext-runtime \
            mingw-w64-ucrt-x86_64-gst-libav \
            mingw-w64-ucrt-x86_64-gst-plugins-bad \
            mingw-w64-ucrt-x86_64-gst-plugins-base \
            mingw-w64-ucrt-x86_64-gst-plugins-good \
            mingw-w64-ucrt-x86_64-gst-plugins-ugly \
            mingw-w64-ucrt-x86_64-gstreamer \
            mingw-w64-ucrt-x86_64-gtk4 \
            mingw-w64-ucrt-x86_64-hicolor-icon-theme \
            mingw-w64-ucrt-x86_64-libadwaita \
            mingw-w64-ucrt-x86_64-shared-mime-info \
            mingw-w64-ucrt-x86_64-wavpack \
    && rm -rf \
        /opt/msys2/var/cache/pacman/pkg \
        /tmp/msys2-keyring.pkg.tar.zst \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN groupadd --gid 1000 rufin \
    && useradd --uid 1000 --gid 1000 --create-home rufin \
    && mkdir -p /nix /workspace \
    && chown -R rufin:rufin /nix /workspace

COPY --chmod=0644 nix.conf /etc/nix/nix.conf

ENV DO_NOT_TRACK=1 \
    HOME=/home/rufin \
    NIX_REMOTE=local \
    RUFIN_WINDOWS_CARGO=/usr/bin/cargo \
    RUFIN_WINDOWS_PKG_CONFIG=/usr/bin/pkg-config \
    RUFIN_WINDOWS_PKG_CONFIG_SYSROOT=/opt/msys2 \
    RUFIN_WINDOWS_PREFIX=/opt/msys2/ucrt64 \
    RUFIN_WINDOWS_RUSTC=/usr/bin/rustc \
    USER=rufin

USER rufin
WORKDIR /workspace

CMD ["bash"]
