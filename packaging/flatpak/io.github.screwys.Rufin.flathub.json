{
  "app-id": "io.github.screwys.Rufin",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "rufin",
  "separate-locales": false,
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.Notifications",
    "--filesystem=xdg-music:ro",
    "--filesystem=xdg-run/app/com.discordapp.Discord:create"
  ],
  "modules": [
    {
      "name": "rufin",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 cargo/config .cargo/config.toml",
        "cargo fetch --locked --offline --manifest-path Cargo.toml --verbose",
        "cargo build --release --locked --offline -p rufin",
        "install -Dm755 target/release/rufin /app/bin/rufin.bin",
        "install -Dm755 packaging/flatpak/rufin-flatpak /app/bin/rufin",
        "install -Dm644 data/io.github.screwys.Rufin.desktop /app/share/applications/io.github.screwys.Rufin.desktop",
        "install -Dm644 data/io.github.screwys.Rufin.metainfo.xml /app/share/metainfo/io.github.screwys.Rufin.metainfo.xml",
        "install -Dm644 data/icons/hicolor/scalable/apps/io.github.screwys.Rufin.svg /app/share/icons/hicolor/scalable/apps/io.github.screwys.Rufin.svg",
        "install -Dm644 -t /app/share/icons/hicolor/scalable/actions data/icons/hicolor/scalable/actions/*.svg",
        "install -Dm644 -t /app/share/icons/hicolor/scalable/status data/icons/hicolor/scalable/status/*.svg",
        "install -Dm644 -t /app/share/icons/hicolor/512x512/apps data/icons/hicolor/512x512/apps/*.png",
        "install -Dm644 -t /app/share/icons/hicolor/64x64/apps data/icons/hicolor/64x64/apps/*.png",
        "test -f /app/share/icons/hicolor/scalable/apps/io.github.screwys.Rufin.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/list-drag-handle-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/route-album-artists-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/route-albums-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/route-artists-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/route-favorites-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/route-folders-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/route-genres-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/route-home-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/route-playlists-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/route-smart-playlists-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/route-tracks-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/view-list-details-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/actions/view-list-ordered-symbolic.svg",
        "test -f /app/share/icons/hicolor/scalable/status/io.github.screwys.Rufin.scrobbling-symbolic.svg",
        "test -f /app/share/icons/hicolor/512x512/apps/io.github.screwys.Rufin.png",
        "test -f /app/share/icons/hicolor/64x64/apps/io.github.screwys.Rufin.external.lastfm.png",
        "test -f /app/share/icons/hicolor/64x64/apps/io.github.screwys.Rufin.external.musicbrainz.png",
        "test -f /app/share/icons/hicolor/64x64/apps/io.github.screwys.Rufin.provider.jellyfin.png",
        "test -f /app/share/icons/hicolor/64x64/apps/io.github.screwys.Rufin.provider.navidrome.png",
        "test -f /app/share/icons/hicolor/64x64/apps/io.github.screwys.Rufin.provider.opensubsonic.png",
        "gtk4-update-icon-cache -f -t /app/share/icons/hicolor || true",
        "for po_file in locales/*.po; do if [ -f \"$po_file\" ]; then lang=\"$(basename \"$po_file\" .po)\"; mkdir -p \"/app/share/locale/$lang/LC_MESSAGES\"; msgfmt \"$po_file\" -o \"/app/share/locale/$lang/LC_MESSAGES/rufin.mo\"; fi; done"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/screwys/Rufin.git",
          "tag": "v0.7.8",
          "commit": "f2fc48d1020167e231d3d17179e2b3e69d50e668"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
