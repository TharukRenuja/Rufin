#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
artifact_root="${RUFIN_ARTIFACT_ROOT:-${repo_root}/.local/artifacts}"
work_root="${RUFIN_WINDOWS_WORK_ROOT:-${artifact_root}/windows}"
target_dir="${RUFIN_WINDOWS_TARGET_DIR:-${CARGO_TARGET_DIR:-${work_root}/target}}"
stage_dir="${RUFIN_WINDOWS_STAGE_DIR:-${work_root}/Rufin}"
verify_target_dir="${RUFIN_WINDOWS_VERIFY_TARGET_DIR:-${CARGO_TARGET_DIR:-${work_root}/verify-target}}"
if [[ "${MSYSTEM:-}" != "UCRT64" || "${MINGW_PREFIX:-}" != "/ucrt64" ]]; then
    echo "Run 'just build windows' from an MSYS2 UCRT64 terminal on Windows." >&2
    exit 1
fi

for command in cargo cygpath makensis rustc; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "$command is required to build the Windows installer." >&2
        exit 1
    fi
done

host_target="$(rustc -vV | sed -n 's/^host: //p')"
version="$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$repo_root/Cargo.toml" | head -n 1)"
version_base="${version%%-*}"
IFS=. read -r version_major version_minor version_patch <<<"$version_base"
version_quad="${version_major:-0}.${version_minor:-0}.${version_patch:-0}.0"

if [[ "$host_target" != "x86_64-pc-windows-gnu" || -z "$version" \
    || ! "$version_quad" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "The MSYS2 Rust toolchain or Rufin version is unavailable." >&2
    exit 1
fi

mkdir -p "$artifact_root" "$work_root"
runtime_prefix="$MINGW_PREFIX"
CARGO_TARGET_DIR="$target_dir" cargo build --locked --release -p rufin
binary="$target_dir/release/rufin.exe"

RUFIN_WINDOWS_BINARY="$binary" \
RUFIN_WINDOWS_PREFIX="$runtime_prefix" \
RUFIN_WINDOWS_STAGE_DIR="$stage_dir" \
    "$repo_root/packaging/windows/package"

CARGO_TARGET_DIR="$verify_target_dir" \
    cargo run --locked -p xtask -- \
        verify package-layout "$stage_dir" ""

stage_argument="$(cygpath -w "$stage_dir")"
stage_files_argument="${stage_argument}\\*"
output_argument="$(cygpath -w "$artifact_root")"
asset_argument="$(cygpath -w "$repo_root/packaging/windows/assets")"

MSYS2_ARG_CONV_EXCL='/D' makensis \
    "/DRUFIN_STAGE_DIR=${stage_argument}" \
    "/DRUFIN_STAGE_FILES=${stage_files_argument}" \
    "/DRUFIN_OUTPUT_DIR=${output_argument}" \
    "/DRUFIN_ASSET_DIR=${asset_argument}" \
    "/DRUFIN_VERSION=${version}" \
    "/DRUFIN_VERSION_QUAD=${version_quad}" \
    "$repo_root/packaging/windows/rufin.nsi"

installer="$artifact_root/Rufin-${version}-setup.exe"
if [[ ! -s "$installer" ]]; then
    echo "The Windows installer was not produced: ${installer}" >&2
    exit 1
fi
echo "Built ${installer}"
