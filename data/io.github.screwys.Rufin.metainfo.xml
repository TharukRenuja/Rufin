<component type="desktop-application">
  <id>io.github.screwys.Rufin</id>
  <name>Rufin</name>
  <summary>Music client for servers and local libraries</summary>
  <developer id="io.github.screwys">
    <name>screwys</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <url type="homepage">https://github.com/screwys/Rufin</url>
  <description>
    <p>Rufin is a native GTK4/libadwaita music client for Jellyfin, Subsonic, Navidrome, and local music folders. It creates its own local cache for fast navigation.</p>
    <p>It comes with built-in scrobbling for Last.fm, Libre.fm, and ListenBrainz; Discord Rich Presence, external lyrics and cover art lookup, and flexible library display options.</p>
  </description>
